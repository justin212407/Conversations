{
  "name": "@conversations/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env dist/migrate-cli.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@conversations/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.2",
    "typescript": "5.9.3",
    "tsx": "4.23.15"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
