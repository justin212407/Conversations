{
  "name": "Conversations",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "services:build": "pnpm --filter '@conversations/*' -r build",
    "services:typecheck": "pnpm --filter '@conversations/*' -r typecheck",
    "services:lint": "pnpm --filter '@conversations/*' -r lint",
    "services:test": "pnpm --filter @conversations/service-runtime test",
    "services:dev": "pnpm services:build && pnpm --parallel --filter @conversations/api --filter @conversations/worker --filter @conversations/realtime dev",
    "services:probe": "pnpm --filter @conversations/worker probe",
    "services:smoke": "node --env-file-if-exists=.env scripts/check-service-foundation.mjs"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  }
}
