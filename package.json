{
  "name": "Conversations",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "services:build": "pnpm --filter '@conversations/*' -r build",
    "services:typecheck": "pnpm --filter '@conversations/*' -r typecheck",
    "services:lint": "pnpm --filter '@conversations/*' -r lint",
    "services:test": "pnpm --filter '@conversations/*' -r --workspace-concurrency=1 --if-present test",
    "services:dev": "pnpm services:build && pnpm --parallel --filter @conversations/api --filter @conversations/worker --filter @conversations/realtime dev",
    "services:probe": "pnpm --filter @conversations/worker probe",
    "services:smoke": "node --env-file-if-exists=.env scripts/check-service-foundation.mjs",
    "services:migrate": "pnpm --filter @conversations/database migrate",
    "observability:prepare": "node --env-file-if-exists=.env scripts/prepare-observability.mjs",
    "services:regression": "node scripts/check-service-regression.mjs",
    "services:gate-test": "node --test scripts/test/*.test.mjs",
    "services:gate-lint": "node apps/api/node_modules/eslint/bin/eslint.js --config scripts/eslint.config.mjs scripts/regression scripts/test scripts/browser-test scripts/check-service-regression.mjs scripts/check-workspace-browser.mjs scripts/audit-dependencies.mjs --max-warnings 0",
    "dependencies:audit": "node scripts/audit-dependencies.mjs",
    "legacy:test": "pnpm --filter @workspace/backend test:compatibility",
    "workspace:regression": "node scripts/check-workspace-browser.mjs",
    "workspace:browser-install": "pnpm --filter web exec playwright install chromium",
    "workspace:browser-test": "node --test --test-concurrency=1 scripts/browser-test/*.test.mjs"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3.1.2": "3.1.5",
      "flatted@3.3.3": "3.4.2",
      "picomatch@2.3.1": "2.3.2",
      "@google/genai@2.32.0>ws": "8.22.1",
      "brace-expansion@1.1.12": "1.1.20",
      "brace-expansion@5.0.6": "5.0.12",
      "fast-uri@3.1.2": "3.1.7",
      "ip-address@10.2.0": "10.3.1",
      "nanoid@3.3.11": "3.3.18",
      "source-map-js@1.2.1": "1.2.2",
      "@babel/helper-compilation-targets@7.28.6>browserslist": "4.29.3",
      "@ai-sdk/provider-utils@3.0.44>undici": "6.29.1"
    },
    "patchedDependencies": {
      "@convex-dev/agent@0.2.12": "patches/@convex-dev__agent@0.2.12.patch"
    }
  }
}
