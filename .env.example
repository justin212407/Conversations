# Local-only values for the isolated Conversations development stack.
# Copy to .env for host services. Compose supplies internal service URLs.
DATABASE_URL=postgresql://conversations:conversations_local@127.0.0.1:55432/conversations
REDIS_URL=redis://127.0.0.1:56379
HOST=127.0.0.1
LOG_LEVEL=info
HEALTH_TIMEOUT_MS=1500
SHUTDOWN_TIMEOUT_MS=10000

# Optional host-port overrides for Docker Compose.
CONVERSATIONS_POSTGRES_PORT=55432
CONVERSATIONS_REDIS_PORT=56379
CONVERSATIONS_API_PORT=4300
CONVERSATIONS_REALTIME_PORT=4301
CONVERSATIONS_WORKER_PORT=4302
CONVERSATIONS_WEB_PORT=4303

# Existing frontend profile: copy actual development keys from your Clerk setup.
# These are examples only; no external credentials are needed for the foundation.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# API verifies sessions from this Clerk instance. Keep blank for health-only local use.
CLERK_JWT_ISSUER_DOMAIN=
# Optional PEM verification key; otherwise the server secret retrieves Clerk JWKS.
CLERK_JWT_KEY=
# Optional in development (localhost defaults); explicit allowlist required in production.
CLERK_AUTHORIZED_PARTIES=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_API_URL=http://localhost:4300
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4301

# Server-only shared API/realtime secret: generate at least 32 random bytes.
# Never expose this through NEXT_PUBLIC_, tickets or browser requests.
REALTIME_INTERNAL_SECRET=
REALTIME_PUBLIC_URL=ws://localhost:4301/v1/connect
REALTIME_API_URL=http://127.0.0.1:4300
REALTIME_REDIS_PREFIX=conversations-realtime
REALTIME_ACCESS_CHECK_MS=5000
REALTIME_HEARTBEAT_MS=15000

# Text worker: real Gemini by default; deterministic is allowed only in development/test.
TEXT_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TEXT_GENERATION_TIMEOUT_MS=60000
TEXT_QUEUE_PREFIX=conversations

# Later issues introduce voice/telemetry configuration when consumed.
