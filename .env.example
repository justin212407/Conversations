# Local-only values for the isolated Conversations development stack.
# Copy to .env for host services. Compose supplies internal service URLs.
DATABASE_URL=postgresql://conversations:conversations_local@127.0.0.1:55432/conversations
REDIS_URL=redis://127.0.0.1:56379
HOST=127.0.0.1
LOG_LEVEL=info
HEALTH_TIMEOUT_MS=1500
SHUTDOWN_TIMEOUT_MS=10000

# Optional host-port overrides for Docker Compose.
CONVERSATIONS_POSTGRES_PORT=55432
CONVERSATIONS_REDIS_PORT=56379
CONVERSATIONS_API_PORT=4300
CONVERSATIONS_REALTIME_PORT=4301
CONVERSATIONS_WORKER_PORT=4302
CONVERSATIONS_WEB_PORT=4303

# Existing frontend profile: copy actual development keys from your Clerk setup.
# These are examples only; no external credentials are needed for the foundation.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_API_URL=http://localhost:4300
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4301

# Later issues introduce provider/auth/telemetry configuration when consumed.
