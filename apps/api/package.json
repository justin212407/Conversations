{
  "name": "@conversations/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.26.4",
    "@conversations/database": "workspace:^",
    "@conversations/service-runtime": "workspace:*",
    "@conversations/shared": "workspace:*",
    "@fastify/cors": "11.3.1",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "jose": "6.2.13",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
