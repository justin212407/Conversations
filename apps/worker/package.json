{
  "name": "@conversations/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "probe": "node --env-file-if-exists=../../.env --import tsx src/probe.ts"
  },
  "dependencies": {
    "@conversations/shared": "workspace:*",
    "@conversations/service-runtime": "workspace:*",
    "bullmq": "6.5.0"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.2",
    "typescript": "5.9.3",
    "tsx": "4.23.15"
  }
}
